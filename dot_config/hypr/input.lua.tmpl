{{- $chassisType := "desktop" -}}
{{- if hasKey . "chassisType" -}}
{{-   $chassisType = .chassisType -}}
{{- end -}}
hl.config({
    input = {
        kb_layout = "us",
        kb_variant = "intl",
        kb_model = "",
        kb_options = "",
        kb_rules = "",
        follow_mouse = 1,
        sensitivity = 0,
        touchpad = {
            natural_scroll = {{ if eq $chassisType "laptop" }}true{{ else }}false{{ end }},
            tap_to_click = true,
            tap_and_drag = true,
            drag_lock = false,
            disable_while_typing = true,
            tap_button_map = "lrm"
        }
    }
})

{{- if eq $chassisType "laptop" }}
-- Trocar de workspace deslizando 4 dedos para os lados (esquerda/direita)
hl.gesture({
    fingers = 4,
    direction = "horizontal",
    action = "workspace"
})

-- 3 dedos para cima: abrir menu de aplicativos do Quickshell
hl.gesture({
    fingers = 3,
    direction = "up",
    action = function()
        hl.dispatch(hl.dsp.global("quickshell:OpenMenu"))
    end
})

-- 3 dedos para baixo: alternar janela flutuante
hl.gesture({
    fingers = 3,
    direction = "down",
    action = function()
        hl.dispatch(hl.dsp.window.float({ action = "toggle" }))
    end
})

-- 4 dedos para cima: abrir/ocultar Special Workspace (Scratchpad)
hl.gesture({
    fingers = 4,
    direction = "up",
    action = function()
        hl.dispatch(hl.dsp.workspace.toggle_special("magic"))
    end
})

-- 4 dedos para baixo: bloquear a tela
hl.gesture({
    fingers = 4,
    direction = "down",
    action = function()
        hl.dispatch(hl.dsp.exec_cmd("quickshell -c widget ipc call shell lock"))
    end
})
{{- end }}

hl.device({
    name = "epic-mouse-v1",
    sensitivity = -0.5
})

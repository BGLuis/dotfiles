{{- $chassisType := "desktop" -}}
{{- if hasKey . "chassisType" -}}
{{-   $chassisType = .chassisType -}}
{{- end -}}
hl.config({
    input = {
        kb_layout = "us",
        kb_variant = "intl",
        kb_model = "",
        kb_options = "",
        kb_rules = "",
        follow_mouse = 1,
        sensitivity = 0,
        touchpad = {
            natural_scroll = {{ if eq $chassisType "laptop" }}true{{ else }}false{{ end }},
            tap_to_click = true,
            tap_and_drag = true,
            drag_lock = false,
            disable_while_typing = true,
            tap_button_map = "lrm"
        }
    },
    gestures = {
{{- if eq $chassisType "laptop" }}
        workspace_swipe = true,
        workspace_swipe_fingers = 3,
        workspace_swipe_distance = 300,
        workspace_swipe_invert = true,
        workspace_swipe_min_speed_to_force = 30,
        workspace_swipe_cancel_ratio = 0.5,
        workspace_swipe_create_new = true,
{{- else }}
        -- workspace_swipe = false
{{- end }}
    }
})

hl.device({
    name = "epic-mouse-v1",
    sensitivity = -0.5
})

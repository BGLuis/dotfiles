{{- $chassisType := "desktop" -}}
{{- if hasKey . "chassisType" -}}
{{-   $chassisType = .chassisType -}}
{{- end -}}
hl.config({
    input = {
        kb_layout = "us",
        kb_variant = "intl",
        kb_model = "",
        kb_options = "",
        kb_rules = "",
        follow_mouse = 1,
        sensitivity = 0,
        touchpad = {
            natural_scroll = {{ if eq $chassisType "laptop" }}true{{ else }}false{{ end }},
            tap_to_click = true,
            tap_and_drag = true,
            drag_lock = false,
            disable_while_typing = true,
            tap_button_map = "lrm"
        }
    }
})

{{- if eq $chassisType "laptop" }}
-- Trocar de workspace deslizando 4 dedos para os lados (esquerda/direita)
hl.gesture({
    fingers = 4,
    direction = "horizontal",
    action = "workspace"
})

-- 3 dedos para cima: abrir menu do Quickshell / lançador
hl.gesture({
    fingers = 3,
    direction = "up",
    action = "global quickshell:OpenMenu"
})

-- 3 dedos para baixo: alternar janela flutuante
hl.gesture({
    fingers = 3,
    direction = "down",
    action = "togglefloating"
})
{{- end }}

hl.device({
    name = "epic-mouse-v1",
    sensitivity = -0.5
})

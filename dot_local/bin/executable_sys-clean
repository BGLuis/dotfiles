#!/usr/bin/env bash
# ==============================================================================
# sys-clean: Utilitário de diagnóstico e limpeza do sistema e ambiente dev
# ==============================================================================

set -uo pipefail

# Cores para saída no terminal
if [ -t 1 ]; then
    BOLD="\033[1m"
    RESET="\033[0m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    RED="\033[31m"
    BLUE="\033[34m"
    CYAN="\033[36m"
else
    BOLD=""
    RESET=""
    GREEN=""
    YELLOW=""
    RED=""
    BLUE=""
    CYAN=""
fi

log_info() { echo -e "${BLUE}${BOLD}==>${RESET} ${BOLD}$*${RESET}"; }
log_success() { echo -e "  ${GREEN}✓${RESET} $*"; }
log_warn() { echo -e "  ${YELLOW}⚠${RESET} $*"; }
log_err() { echo -e "  ${RED}✗${RESET} $*"; }

ASSUME_YES=0
DRY_RUN=0
STALE_DAYS=30

get_size() {
    local target="$1"
    if [ -e "$target" ]; then
        local sz
        sz=$(du -sh "$target" 2>/dev/null | awk '{print $1}')
        echo "${sz:-0B}"
    else
        echo "0B"
    fi
}

# Sem terminal e sem --yes a resposta é sempre "não": nada destrutivo roda sem consentimento.
confirm() {
    local prompt="$1" resp
    if [ "$DRY_RUN" = 1 ] || [ "$ASSUME_YES" = 1 ]; then
        return 0
    fi
    if [ ! -t 0 ]; then
        log_warn "Sem terminal interativo, pulando (use --yes para confirmar): $prompt"
        return 1
    fi
    read -r -p "  $prompt [s/N]: " resp
    [[ "$resp" =~ ^[sSyY]$ ]]
}

run() {
    if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] $*"
    else
        "$@"
    fi
}

do_rm() {
    local p
    for p in "$@"; do
        [ -e "$p" ] || continue
        if [ "$DRY_RUN" = 1 ]; then
            echo "  [dry-run] rm -rf $p ($(get_size "$p"))"
        else
            rm -rf "$p" 2>/dev/null || true
        fi
    done
}

# Diretórios ocultos (.cache, .cargo, .rustup...) são podados, exceto os de build listados.
find_build_dirs() {
    local root="$1" depth="$2"
    find "$root" -mindepth 1 -maxdepth "$depth" -type d \
        \( \( -name target -o -name build -o -name node_modules -o -name .angular -o -name .dart_tool \) -print -prune \
        -o -name '.*' -prune \) 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# 1. DIAGNÓSTICO E VARREDURA (--scan)
# ------------------------------------------------------------------------------
run_scan() {
    echo -e "${BOLD}==========================================================================${RESET}"
    echo -e "${CYAN}${BOLD} 📊 Diagnóstico de Espaço em Disco e Caches${RESET}"
    echo -e "${BOLD}==========================================================================${RESET}"
    echo ""

    # Pacotes e Sistema
    echo -e "${BOLD}[ Sistema & Pacotes ]${RESET}"
    [ -d /var/cache/pacman/pkg ] && printf "  %-38s : %s\n" "Cache do Pacman (/var/cache/pacman/pkg)" "$(get_size /var/cache/pacman/pkg)"
    [ -d "$HOME/.cache/yay" ] && printf "  %-38s : %s\n" "Cache do Yay (~/.cache/yay)" "$(get_size "$HOME/.cache/yay")"
    if command -v pacman >/dev/null 2>&1; then
        local orphans
        orphans=$(pacman -Qtdq 2>/dev/null | wc -l)
        printf "  %-38s : %s pacotes\n" "Pacotes órfãos (pacman -Qtdq)" "$orphans"
    fi
    if command -v journalctl >/dev/null 2>&1; then
        local jsize
        jsize=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)?[KMGT]i?B?' | head -n1 || echo "N/A")
        printf "  %-38s : %s\n" "Logs do Systemd (journalctl)" "$jsize"
    fi
    [ -d "$HOME/.local/share/Trash" ] && printf "  %-38s : %s\n" "Lixeira do Usuário (~/.local/share/Trash)" "$(get_size "$HOME/.local/share/Trash")"
    [ -d "$HOME/.cache/thumbnails" ] && printf "  %-38s : %s\n" "Miniaturas (~/.cache/thumbnails)" "$(get_size "$HOME/.cache/thumbnails")"

    # Ferramentas de Desenvolvimento
    echo ""
    echo -e "${BOLD}[ Ferramentas de Desenvolvimento ]${RESET}"
    [ -d "$HOME/.gradle/caches" ] && printf "  %-38s : %s\n" "Cache do Gradle (~/.gradle/caches)" "$(get_size "$HOME/.gradle/caches")"
    [ -d "$HOME/.npm/_cacache" ] && printf "  %-38s : %s\n" "Cache do NPM (~/.npm/_cacache)" "$(get_size "$HOME/.npm/_cacache")"
    [ -d "$HOME/.npm/_npx" ] && printf "  %-38s : %s\n" "Pacotes temporários npx (~/.npm/_npx)" "$(get_size "$HOME/.npm/_npx")"
    [ -d "$HOME/go/pkg/mod" ] && printf "  %-38s : %s\n" "Cache de módulos Go (~/go/pkg/mod)" "$(get_size "$HOME/go/pkg/mod")"
    [ -d "$HOME/.cargo/registry/cache" ] && printf "  %-38s : %s\n" "Cache de crates Cargo (~/.cargo/registry)" "$(get_size "$HOME/.cargo/registry/cache")"
    [ -d "$HOME/.cache/uv" ] && printf "  %-38s : %s\n" "Cache do Python uv (~/.cache/uv)" "$(get_size "$HOME/.cache/uv")"
    [ -d "$HOME/.cache/pip" ] && printf "  %-38s : %s\n" "Cache do Python pip (~/.cache/pip)" "$(get_size "$HOME/.cache/pip")"

    # Docker
    echo ""
    echo -e "${BOLD}[ Docker ]${RESET}"
    if command -v docker >/dev/null 2>&1; then
        if timeout 3 docker info >/dev/null 2>&1; then
            local bcache
            bcache=$(docker builder du 2>/dev/null | grep -E '^Total:' | awk '{print $2}' || echo "N/A")
            local dimages
            dimages=$(docker images -f "dangling=true" -q 2>/dev/null | wc -l)
            printf "  %-38s : %s\n" "Docker Build Cache" "$bcache"
            printf "  %-38s : %s imagens\n" "Docker imagens órfãs (dangling)" "$dimages"
        else
            printf "  %-38s : %s\n" "Docker Daemon" "Inativo / inacessível"
        fi
    else
        printf "  %-38s : %s\n" "Docker" "Não instalado"
    fi

    # IA, MCP & Headless Browsers
    echo ""
    echo -e "${BOLD}[ IA, MCPs & Headless Browsers ]${RESET}"
    [ -d "$HOME/.gemini/tmp" ] && printf "  %-38s : %s\n" "Temporários Gemini (~/.gemini/tmp)" "$(get_size "$HOME/.gemini/tmp")"
    [ -d "$HOME/.cache/ms-playwright" ] && printf "  %-38s : %s\n" "Navegadores Playwright (~/.cache/ms-playwright)" "$(get_size "$HOME/.cache/ms-playwright")"
    [ -d "$HOME/.cache/puppeteer" ] && printf "  %-38s : %s\n" "Navegadores Puppeteer (~/.cache/puppeteer)" "$(get_size "$HOME/.cache/puppeteer")"
    [ -d "$HOME/.cache/chrome-devtools-mcp" ] && printf "  %-38s : %s\n" "Caches Chrome DevTools MCP" "$(get_size "$HOME/.cache/chrome-devtools-mcp")"

    # Aplicativos e Launchers
    echo ""
    echo -e "${BOLD}[ Caches de Aplicativos & Launchers ]${RESET}"
    [ -d "$HOME/.cache/vicinae/file-indexer" ] && printf "  %-38s : %s\n" "Indexador Vicinae (~/.cache/vicinae/file-indexer)" "$(get_size "$HOME/.cache/vicinae/file-indexer")"
    [ -d "$HOME/.cache/spotify" ] && printf "  %-38s : %s\n" "Cache do Spotify (~/.cache/spotify)" "$(get_size "$HOME/.cache/spotify")"
    [ -d "$HOME/.cache/vivaldi" ] && printf "  %-38s : %s\n" "Cache do Vivaldi (~/.cache/vivaldi)" "$(get_size "$HOME/.cache/vivaldi")"
    [ -d "$HOME/.cache/umu" ] && printf "  %-38s : %s\n" "Cache UMU/Proton (~/.cache/umu)" "$(get_size "$HOME/.cache/umu")"

    # Dados que não são cache: apenas informativo, o sys-clean nunca remove
    echo ""
    echo -e "${BOLD}[ Dados de Aplicativos (informativo, não removidos) ]${RESET}"
    [ -d "$HOME/.gemini/antigravity-cli" ] && printf "  %-38s : %s\n" "Sessões Antigravity (~/.gemini/antigravity-cli)" "$(get_size "$HOME/.gemini/antigravity-cli")"
    [ -d "$HOME/.gemini/extensions" ] && printf "  %-38s : %s\n" "Extensões Gemini (~/.gemini/extensions)" "$(get_size "$HOME/.gemini/extensions")"
    [ -d "$HOME/.rustup" ] && printf "  %-38s : %s\n" "Toolchains Rust (~/.rustup)" "$(get_size "$HOME/.rustup")"
    [ -d "$HOME/.vscode-server" ] && printf "  %-38s : %s\n" "VS Code Server (~/.vscode-server)" "$(get_size "$HOME/.vscode-server")"

    # Varredura de Projetos (se existirem diretórios comuns)
    local scan_dir="${1:-$HOME}"
    if [ -d "$scan_dir" ]; then
        echo ""
        echo -e "${BOLD}[ Artefatos de Build em ${scan_dir} ]${RESET}"
        local build_targets found=0
        build_targets=$(find_build_dirs "$scan_dir" 4)
        if [ -n "$build_targets" ]; then
            while IFS= read -r dir; do
                [ -d "$dir" ] || continue
                local kb
                kb=$(du -sk "$dir" 2>/dev/null | cut -f1)
                # Filtra apenas se for maior que 50M para não poluir
                if [ "${kb:-0}" -ge 51200 ]; then
                    printf "  %-50s : %s\n" "${dir#"$HOME"/}" "$(get_size "$dir")"
                    found=1
                fi
            done <<< "$build_targets"
        fi
        [ "$found" = 0 ] && echo "  Nenhum artefato relevante encontrado."

        local worktrees
        worktrees=$(find "$scan_dir" -maxdepth 2 -name .git -type f 2>/dev/null || true)
        if [ -n "$worktrees" ]; then
            echo ""
            echo -e "${BOLD}[ Git Worktrees em ${scan_dir} ]${RESET}"
            while IFS= read -r gitfile; do
                local wt
                wt=$(dirname "$gitfile")
                printf "  %-50s : %s\n" "${wt#"$HOME"/}" "$(get_size "$wt")"
            done <<< "$worktrees"
        fi
    fi

    echo ""
    echo -e "${BOLD}==========================================================================${RESET}"
    echo -e " Execute ${CYAN}sys-clean --help${RESET} para opções de limpeza específicas ou ${CYAN}sys-clean --all${RESET}."
    echo -e "${BOLD}==========================================================================${RESET}"
}

# ------------------------------------------------------------------------------
# 2. LIMPEZAS ESPECÍFICAS
# ------------------------------------------------------------------------------

clean_system() {
    log_info "Limpando caches do sistema e gerenciadores de pacotes..."
    confirm "Limpar cache do pacman/yay, logs do systemd, miniaturas e lixeira?" || return 0

    # Pacman cache
    if command -v paccache >/dev/null 2>&1; then
        echo "  -> Executando paccache (mantendo 2 versões mais recentes)..."
        run sudo paccache -rk2 || log_warn "Aviso ao executar paccache -rk2"
        echo "  -> Removendo pacotes desinstalados do cache..."
        run sudo paccache -ruk0 2>/dev/null || true
    elif command -v pacman >/dev/null 2>&1; then
        echo "  -> Limpando cache do pacman (pacman -Sc)..."
        run sudo pacman -Sc --noconfirm || log_warn "Aviso no pacman -Sc"
    fi

    # Yay cache
    if command -v yay >/dev/null 2>&1; then
        echo "  -> Limpando cache do Yay..."
        run yay -Sc --noconfirm 2>/dev/null || true
    fi

    # Journalctl logs
    if command -v journalctl >/dev/null 2>&1; then
        echo "  -> Reduzindo logs do systemd para 2 semanas..."
        run sudo journalctl --vacuum-time=2weeks 2>/dev/null || true
        run journalctl --user --vacuum-time=2weeks 2>/dev/null || true
    fi

    # Lixeira e miniaturas
    echo "  -> Limpando miniaturas e lixeira..."
    do_rm "$HOME/.cache/thumbnails"/*
    do_rm "$HOME/.local/share/Trash"/*

    # Pacotes órfãos (interativo se em terminal)
    if command -v pacman >/dev/null 2>&1; then
        local orphans=()
        mapfile -t orphans < <(pacman -Qtdq 2>/dev/null || true)
        if [ ${#orphans[@]} -gt 0 ]; then
            echo ""
            log_warn "Foram encontrados ${#orphans[@]} pacotes órfãos no sistema."
            if [ "$DRY_RUN" = 1 ]; then
                echo "  [dry-run] sudo pacman -Rns ${orphans[*]}"
            elif [ -t 0 ]; then
                local resp
                read -r -p "  Deseja remover os pacotes órfãos agora? [s/N]: " resp
                if [[ "$resp" =~ ^[sSyY]$ ]]; then
                    sudo pacman -Rns "${orphans[@]}" || log_warn "Não foi possível remover alguns órfãos."
                fi
            fi
        fi
    fi

    log_success "Limpeza de sistema concluída."
}

clean_dev() {
    log_info "Limpando caches de linguagens e ferramentas de desenvolvimento..."
    confirm "Limpar caches de NPM, Gradle, Go, Cargo e Python (serão baixados de novo)?" || return 0

    # NPM
    if [ -d "$HOME/.npm/_cacache" ] || [ -d "$HOME/.npm/_npx" ]; then
        echo "  -> Limpando cache do NPM..."
        do_rm "$HOME/.npm/_cacache" "$HOME/.npm/_npx"
        if command -v npm >/dev/null 2>&1; then
            run npm cache clean --force 2>/dev/null || true
        fi
        log_success "Cache do NPM liberado."
    fi

    # Gradle
    if [ -d "$HOME/.gradle/caches" ]; then
        echo "  -> Parando daemons do Gradle e limpando caches..."
        if command -v gradle >/dev/null 2>&1; then
            run gradle --stop 2>/dev/null || true
        fi
        do_rm "$HOME/.gradle/caches" "$HOME/.gradle/daemon"
        log_success "Caches do Gradle liberados."
    fi

    # Go
    if [ -d "$HOME/go/pkg/mod" ] && command -v go >/dev/null 2>&1; then
        echo "  -> Limpando cache de módulos Go..."
        run go clean -modcache 2>/dev/null || true
        log_success "Cache de módulos Go liberado."
    fi

    # Cargo
    if [ -d "$HOME/.cargo/registry/cache" ]; then
        echo "  -> Limpando arquivos .crate baixados pelo Cargo..."
        do_rm "$HOME/.cargo/registry/cache"/*
        log_success "Cache de crates do Cargo liberado."
    fi

    # Python uv / pip
    if [ -d "$HOME/.cache/uv" ] || [ -d "$HOME/.cache/pip" ]; then
        echo "  -> Limpando caches do Python (uv/pip)..."
        do_rm "$HOME/.cache/uv" "$HOME/.cache/pip"
        log_success "Caches Python liberados."
    fi

    log_success "Limpeza de ferramentas dev concluída."
}

clean_docker() {
    log_info "Limpando Docker (build cache, imagens sem tag e volumes)..."
    if ! command -v docker >/dev/null 2>&1; then
        log_warn "Docker não está instalado."
        return 0
    fi

    if ! timeout 3 docker info >/dev/null 2>&1; then
        log_warn "Daemon do Docker não está em execução ou usuário sem permissão no socket."
        return 0
    fi

    if confirm "Remover todo o build cache e todas as imagens sem container?"; then
        echo "  -> Limpando Docker builder cache..."
        run timeout 60 docker builder prune -a -f || log_warn "Timeout ou erro ao limpar build cache"

        echo "  -> Removendo imagens não utilizadas..."
        run timeout 60 docker image prune -a -f || log_warn "Timeout ou erro ao limpar imagens"
    fi

    echo ""
    echo "  Volumes existentes:"
    docker volume ls 2>/dev/null | sed 's/^/    /'
    if confirm "Remover volumes sem container associado? (os dados deles serão perdidos)"; then
        echo "  -> Removendo volumes órfãos..."
        run timeout 30 docker volume prune -f || log_warn "Timeout ou erro ao limpar volumes"
    fi

    log_success "Limpeza do Docker concluída."
}

clean_ai_mcp() {
    log_info "Limpando caches de IA, MCP e navegadores headless..."
    confirm "Limpar ~/.gemini/tmp, navegadores headless e índice do Vicinae?" || return 0

    # Gemini temp files
    if [ -d "$HOME/.gemini/tmp" ]; then
        echo "  -> Limpando diretórios temporários em ~/.gemini/tmp..."
        do_rm "$HOME/.gemini/tmp"/*
        log_success "Temporários do Gemini liberados."
    fi

    # Playwright / Puppeteer / MCP browsers
    local browser_caches=(
        "$HOME/.cache/ms-playwright"
        "$HOME/.cache/puppeteer"
        "$HOME/.cache/chrome-devtools-mcp"
        "$HOME/.cache/google-chrome-headless"
        "$HOME/.cache/chromium-headless"
    )

    for bpath in "${browser_caches[@]}"; do
        if [ -d "$bpath" ]; then
            echo "  -> Removendo $bpath ($(get_size "$bpath"))..."
            do_rm "$bpath"
        fi
    done

    # Vicinae file indexer
    if [ -d "$HOME/.cache/vicinae/file-indexer" ]; then
        echo "  -> Resetando cache do indexador Vicinae..."
        do_rm "$HOME/.cache/vicinae/file-indexer"
    fi

    log_success "Caches de IA e navegadores headless liberados."
}

clean_builds() {
    local target_root="${1:-$HOME}"
    log_info "Buscando diretórios de build descartáveis em: $target_root"

    if [ ! -d "$target_root" ]; then
        log_err "Diretório $target_root não encontrado."
        return 1
    fi

    local found_dirs=()
    while IFS= read -r d; do
        [ -d "$d" ] && found_dirs+=("$d")
    done < <(find_build_dirs "$target_root" 4)

    if [ ${#found_dirs[@]} -eq 0 ]; then
        log_success "Nenhum diretório de build encontrado em $target_root."
        return 0
    fi

    echo ""
    echo "Diretórios de compilação encontrados:"
    local i=1
    for d in "${found_dirs[@]}"; do
        printf "  [%2d] %-8s %s\n" "$i" "$(get_size "$d")" "${d#"$HOME"/}"
        ((i++))
    done
    echo ""

    if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] nada removido."
        return 0
    fi

    if [ ! -t 0 ]; then
        log_warn "Modo não interativo: nada foi removido (rode em um terminal para escolher)."
        return 0
    fi

    echo -e "${YELLOW}Atenção: Esses diretórios contêm artefatos de compilação gerados.${RESET}"
    echo -e "Eles podem ser recompilados a qualquer momento pelo cargo, flutter, npm etc."
    echo ""
    read -r -p "Digite os números para apagar (ex: 1 3 5), 'all' para todos ou [ENTER] para cancelar: " choice

    if [ "$choice" = "all" ]; then
        for d in "${found_dirs[@]}"; do
            echo "  Removendo $d..."
            do_rm "$d"
        done
        log_success "Todos os diretórios de build listados foram removidos."
    elif [ -n "$choice" ]; then
        for num in $choice; do
            if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#found_dirs[@]}" ]; then
                local sel="${found_dirs[$((num-1))]}"
                echo "  Removendo $sel..."
                do_rm "$sel"
            fi
        done
        log_success "Diretórios selecionados foram removidos."
    else
        echo "Operação cancelada. Nenhum diretório foi modificado."
    fi
}

# Só remove target/ de projetos Cargo (Cargo.toml ao lado) sem nenhum arquivo modificado
# nos últimos N dias; o mtime do diretório não serve porque o cargo altera só arquivos internos.
clean_stale_targets() {
    local root="${1:-$HOME}" days="${2:-$STALE_DAYS}"
    log_info "Buscando target/ de projetos Rust sem modificação há mais de $days dias em: $root"

    if [ ! -d "$root" ]; then
        log_err "Diretório $root não encontrado."
        return 1
    fi

    local stale=() d
    while IFS= read -r d; do
        [ -f "$(dirname "$d")/Cargo.toml" ] || continue
        if [ -z "$(find "$d" -type f -mtime "-$days" -print -quit 2>/dev/null)" ]; then
            stale+=("$d")
        fi
    done < <(find_build_dirs "$root" 4 | grep '/target$' || true)

    if [ ${#stale[@]} -eq 0 ]; then
        log_success "Nenhum target/ antigo encontrado."
        return 0
    fi

    for d in "${stale[@]}"; do
        printf "  %-8s %s\n" "$(get_size "$d")" "${d#"$HOME"/}"
    done

    confirm "Remover ${#stale[@]} diretórios target/ listados (recompiláveis)?" || return 0
    do_rm "${stale[@]}"
    log_success "target/ antigos removidos."
}

# ------------------------------------------------------------------------------
# 3. ROTINA AUTOMÁTICA DO SYSTEMD TIMER (--routine)
# ------------------------------------------------------------------------------
# Sem TTY o sudo precisa de NOPASSWD; a falha é registrada no journal em vez de engolida.
run_routine() {
    log_info "[$(date '+%Y-%m-%d %H:%M:%S')] Iniciando rotina de manutenção periódica (sys-clean)..."

    # 1. Pacman seguro
    if command -v paccache >/dev/null 2>&1; then
        sudo -n paccache -rk2 || log_warn "paccache -rk2 falhou (sudo sem senha configurado?)"
        sudo -n paccache -ruk0 || log_warn "paccache -ruk0 falhou (sudo sem senha configurado?)"
    elif command -v pacman >/dev/null 2>&1; then
        log_warn "paccache ausente: instale pacman-contrib para limpar o cache do pacman."
    fi

    # 2. Systemd journals
    if command -v journalctl >/dev/null 2>&1; then
        sudo -n journalctl --vacuum-time=2weeks || log_warn "journalctl --vacuum falhou (sudo sem senha configurado?)"
        journalctl --user --vacuum-time=2weeks 2>/dev/null || true
    fi

    # 3. Miniaturas velhas (> 14 dias)
    find "$HOME/.cache/thumbnails" -type f -mtime +14 -delete 2>/dev/null || true

    # 4. Gemini tmp velhos (> 7 dias)
    find "$HOME/.gemini/tmp" -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null || true

    # 5. Gradle daemons zumbis
    if [ -d "$HOME/.gradle/daemon" ]; then
        find "$HOME/.gradle/daemon" -type f -mtime +14 -delete 2>/dev/null || true
    fi

    # 6. NPM temporary npx downloads (> 7 dias)
    if [ -d "$HOME/.npm/_npx" ]; then
        find "$HOME/.npm/_npx" -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null || true
    fi

    # 7. Docker builder e dangling images (se estiver rodando)
    if command -v docker >/dev/null 2>&1 && timeout 3 docker info >/dev/null 2>&1; then
        timeout 60 docker builder prune -f 2>/dev/null || true
        timeout 60 docker image prune -f 2>/dev/null || true
    fi

    # 8. target/ de projetos Rust parados
    ASSUME_YES=1
    clean_stale_targets "$HOME" "$STALE_DAYS"

    log_success "[$(date '+%Y-%m-%d %H:%M:%S')] Rotina de manutenção concluída com sucesso."
}

# ------------------------------------------------------------------------------
# 4. MENU PRINCIPAL & PARSER DE ARGUMENTOS
# ------------------------------------------------------------------------------
show_help() {
    cat << EOF
sys-clean - Utilitário de diagnóstico e limpeza do sistema e ambiente dev

Uso: sys-clean [OPÇÃO]...

Opções:
  -s, --scan [DIR]     Apenas diagnostica e exibe o uso de disco (sem apagar nada).
                       Opcionalmente informe o diretório raiz de projetos (padrão: ~).
  -r, --routine        Executa a rotina periódica e segura (chamada pelo systemd timer).
  --system             Limpa caches do pacman/yay, logs velhos do systemd e lixeira.
  --dev                Limpa caches de ferramentas (NPM, Gradle, Go, Cargo, Python).
  --docker             Limpa Docker builder cache, imagens órfãs e volumes.
  --ai-mcp             Limpa temporários do Gemini (~/.gemini/tmp) e navegadores headless.
  --builds [DIR]       Varre diretórios de build (target/, build/, node_modules/) e pergunta o que apagar.
  --stale-targets [DIR]
                       Remove target/ de projetos Rust sem modificação há mais de ${STALE_DAYS} dias (padrão: ~).
  --all                Executa --system, --dev, --docker, --ai-mcp e --stale-targets.
  -y, --yes            Confirma automaticamente as limpezas (necessário sem terminal interativo).
  -n, --dry-run        Mostra o que seria removido, sem apagar nada.
  -h, --help           Exibe esta mensagem de ajuda.

As limpezas pedem confirmação; sem terminal e sem --yes elas são puladas.

Exemplos:
  sys-clean --scan
  sys-clean --builds ~
  sys-clean --all --dry-run
  sys-clean --dev --yes
EOF
}

main() {
    local args=() a
    for a in "$@"; do
        case "$a" in
            -y|--yes) ASSUME_YES=1 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            *) args+=("$a") ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"

    if [ $# -eq 0 ]; then
        # Sem argumentos: roda o scan completo e oferece ajuda
        run_scan "$HOME"
        exit 0
    fi

    local dir
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--scan|--builds|--stale-targets)
                local opt="$1"
                shift
                dir="$HOME"
                if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
                    dir="$1"
                    shift
                fi
                case "$opt" in
                    -s|--scan) run_scan "$dir" ;;
                    --builds) clean_builds "$dir" ;;
                    --stale-targets) clean_stale_targets "$dir" "$STALE_DAYS" ;;
                esac
                ;;
            -r|--routine)
                run_routine
                exit 0
                ;;
            --system)
                clean_system
                shift
                ;;
            --dev)
                clean_dev
                shift
                ;;
            --docker)
                clean_docker
                shift
                ;;
            --ai-mcp)
                clean_ai_mcp
                shift
                ;;
            --all)
                clean_system
                clean_dev
                clean_docker
                clean_ai_mcp
                clean_stale_targets "$HOME" "$STALE_DAYS"
                log_info "Outros build/ e node_modules/ não são removidos pelo --all; use --builds."
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                log_err "Opção desconhecida: $1"
                show_help
                exit 1
                ;;
        esac
    done
}

main "$@"

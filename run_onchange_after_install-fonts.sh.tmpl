{{- if and (eq .chezmoi.os "linux") (ne .chassisType "headless") -}}
#!/bin/bash
set -euo pipefail

# hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

FONT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
mkdir -p "$FONT_DIR"

NEED_CACHE_UPDATE=0

font_installed() {
    # Evita SIGPIPE (código 141) sob 'set -o pipefail' consumindo o output completamente
    fc-list : family | grep -iE "$1" >/dev/null 2>&1
}

echo "==> [chezmoi] Verificando fontes do sistema e ambiente de trabalho..."

# 1. JetBrains Mono Nerd Font (Kitty, Starship, Lazygit, Terminal)
if ! font_installed "JetBrainsMono Nerd Font|JetBrainsMonoNF"; then
    echo "  -> Baixando JetBrains Mono Nerd Font..."
    TMP_DIR=$(mktemp -d)
    JETBRAINS_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
    if curl -fL --progress-bar "$JETBRAINS_URL" -o "$TMP_DIR/JetBrainsMono.tar.xz"; then
        TARGET_DIR="$FONT_DIR/JetBrainsMonoNerd"
        mkdir -p "$TARGET_DIR"
        tar -xf "$TMP_DIR/JetBrainsMono.tar.xz" -C "$TARGET_DIR" --wildcards "*.ttf" 2>/dev/null || \
            tar -xf "$TMP_DIR/JetBrainsMono.tar.xz" -C "$TARGET_DIR"
        NEED_CACHE_UPDATE=1
        echo "  ✓ JetBrains Mono Nerd Font instalada em $TARGET_DIR"
    else
        echo "  ⚠️ Falha ao baixar JetBrains Mono Nerd Font."
    fi
    rm -rf "$TMP_DIR"
else
    echo "  ✓ JetBrains Mono Nerd Font já está presente."
fi

# 2. Rubik (Hyprlock e Quickshell)
if ! font_installed "^Rubik|Rubik Light"; then
    echo "  -> Baixando fonte Rubik..."
    RUBIK_DIR="$FONT_DIR/Rubik"
    mkdir -p "$RUBIK_DIR"
    curl -fsSL "https://raw.githubusercontent.com/google/fonts/main/ofl/rubik/Rubik%5Bwght%5D.ttf" -o "$RUBIK_DIR/Rubik[wght].ttf" || true
    curl -fsSL "https://raw.githubusercontent.com/google/fonts/main/ofl/rubik/Rubik-Italic%5Bwght%5D.ttf" -o "$RUBIK_DIR/Rubik-Italic[wght].ttf" || true
    NEED_CACHE_UPDATE=1
    echo "  ✓ Rubik instalada em $RUBIK_DIR"
else
    echo "  ✓ Rubik já está presente."
fi

# 3. Material Symbols Rounded (Hyprlock e Widgets)
if ! font_installed "Material Symbols"; then
    echo "  -> Baixando Material Symbols Rounded..."
    MATERIAL_DIR="$FONT_DIR/MaterialSymbols"
    mkdir -p "$MATERIAL_DIR"
    curl -fsSL "https://raw.githubusercontent.com/google/material-design-icons/master/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf" -o "$MATERIAL_DIR/MaterialSymbolsRounded.ttf" || true
    NEED_CACHE_UPDATE=1
    echo "  ✓ Material Symbols Rounded instalada em $MATERIAL_DIR"
else
    echo "  ✓ Material Symbols Rounded já está presente."
fi

# Atualizar cache do fontconfig se alguma fonte foi instalada
if [ "$NEED_CACHE_UPDATE" -eq 1 ]; then
    echo "==> [chezmoi] Atualizando cache de fontes do fontconfig (fc-cache)..."
    fc-cache -f "$FONT_DIR"
    echo "==> [chezmoi] Fontes de usuário provisionadas com sucesso!"
else
    echo "==> [chezmoi] Todas as fontes necessárias já estão disponíveis no sistema."
fi
{{- end -}}

{{- /* Detecta automaticamente se a máquina não tem GUI: nenhuma saída de vídeo REAL conectada.
       Ignora GPUs virtuais de hypervisor (qxl, virtio_gpu, cirrus, vboxvideo, vmwgfx, hyperv_drm),
       que costumam reportar "connected" mesmo em VPS/VMs sem monitor de verdade. */ -}}
{{- $isHeadlessDetected := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $connected := output "sh" "-c" `
for f in /sys/class/drm/card*-*/status; do
  [ -f "$f" ] || continue
  st=$(cat "$f" 2>/dev/null)
  [ "$st" = "connected" ] || continue
  card=$(basename "$(dirname "$f")" | cut -d- -f1)
  drv=$(basename "$(readlink -f "/sys/class/drm/$card/device/driver" 2>/dev/null)" 2>/dev/null)
  case "$drv" in
    qxl|virtio_gpu|cirrus|vboxvideo|vmwgfx|hyperv_drm|bochs*) continue ;;
  esac
  echo "$f"
  break
done
true
` | trim -}}
{{-   if eq $connected "" -}}
{{-     $isHeadlessDetected = true -}}
{{-   end -}}
{{- end -}}

{{- $chassisDefault := "desktop" -}}
{{- if $isHeadlessDetected -}}
{{-   $chassisDefault = "headless" -}}
{{- end -}}
{{- $choices := list "desktop" "laptop" "headless" -}}
{{- $chassisType := promptChoiceOnce . "chassisType" "Qual o tipo deste dispositivo? (desktop/laptop/headless)" $choices $chassisDefault -}}

{{- $setupQuickshell := false -}}
{{- if ne $chassisType "headless" -}}
{{-   $setupQuickshell = promptBoolOnce . "setupQuickshell" "Deseja clonar e configurar o Quickshell (barra/widgets) nesta máquina?" true -}}
{{- end -}}

[data]
    chassisType = {{ $chassisType | quote }}
    setupQuickshell = {{ $setupQuickshell }}
